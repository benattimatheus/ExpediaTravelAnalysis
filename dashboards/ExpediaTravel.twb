        <title>
          <formatted-text>
            <run fontcolor='#00355f' fontname='Segoe UI Semibold' fontsize='14'>Top Hotel Clusters Opportunities: High Volume + Low Conversion</run>
            <run>Æ&#10;</run>
            <run fontcolor='#00355f' fontname='Segoe UI Semibold' fontsize='10'>Opportunity Score = Search Volume * (1 - Conversion Rate)</run>
          </formatted-text>
        </title>
