      </column>
      <column caption='Delta Label' datatype='string' name='[Calculation_2699088888664071]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2699088888516614] &gt; 0 THEN&#13;&#10;&quot;+&quot; + STR(ROUND([Calculation_2699088888516614],2)) + &quot;pp&quot;&#13;&#10;ELSE&#13;&#10;STR(ROUND([Calculation_2699088888516614],2)) + &quot;pp&quot;&#13;&#10;END' />
