      <column caption='Booking Window' datatype='integer' name='[Calculation_4356053155106816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [advance_booking_days] &gt;= 0 THEN [advance_booking_days]&#13;&#10;END' />
      </column>
      <column caption='Opportunity Score' datatype='real' name='[Calculation_4356053197479938]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT([id]) * (1 - AVG([is_booking]))' />
