              <calculation class='tableau' formula='IF [Calculation_2699088888516614] &lt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='Desktop' datatype='real' name='[Calculation_2699088884203522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;IF [Is Mobile (cópia)_2699088885530629] = 0 THEN [is_booking] END&#13;&#10;)' />
            </column>
            <column caption='Delta Device (pp)' datatype='real' name='[Calculation_2699088888516614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2699088884203522] - [Desktop (cópia)_2699088884826115]) * 100' />
            </column>
            <column caption='Delta Label' datatype='string' name='[Calculation_2699088888664071]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2699088888516614] &gt; 0 THEN&#13;&#10;&quot;+&quot; + STR(ROUND([Calculation_2699088888516614],2)) + &quot;pp&quot;&#13;&#10;ELSE&#13;&#10;STR(ROUND([Calculation_2699088888516614],2)) + &quot;pp&quot;&#13;&#10;END' />
            </column>
            <column caption='ArrowUpDelta' datatype='string' name='[Calculation_2699088890306569]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2699088888516614] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='DesktopConversion' datatype='string' name='[Delta Label (cópia)_2699088889577480]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2699088888516614] &gt; 0 THEN &quot;Desktop Converts Better&quot; &#13;&#10;ELSE &quot;Mobile Converts Better&quot; END' />
            </column>
            <column caption='Mobile' datatype='real' name='[Desktop (cópia)_2699088884826115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Is Mobile (cópia)_2699088885530629] = 1 THEN [is_booking] END)' />
